{
  "env": {
    "PROJECT_TYPE": "web-visualization",
    "FRAMEWORK": "vanilla-js-threejs",
    "NODE_ENV": "development"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(python:*)",
      "Bash(git:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git tag:*)",
      "Bash(git -C:*)",
      "Bash(gh:*)",
      "Bash(claude:*)",
      "Bash(start:*)",
      "Bash(cmd:*)",
      "Bash(cmd /c:*)",
      "Bash(powershell:*)",
      "Bash(timeout:*)",
      "Bash(curl:*)",
      "Bash(dir:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(findstr:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(copy:*)",
      "Bash(move:*)",
      "Bash(mkdir:*)",
      "Bash(tasklist:*)",
      "Bash(taskkill:*)",
      "Bash(netstat:*)",
      "Read(**/*)",
      "Write(**/js/**/*.js)",
      "Write(**/css/**/*.css)",
      "WebSearch",
      "Skill(brainstorming)",
      "mcp__playwright__*",
      "mcp__desktop-commander__*",
      "mcp__memory__*",
      "Bash(where:*)",
      "Bash(del \"_ul\")",
      "WebFetch(domain:www.anthropic.com)",
      "Bash(echo:*)",
      "Bash(python3:*)",
      "WebFetch(domain:21st.dev)",
      "mcp__magic__21st_magic_component_inspiration",
      "Bash(grep -l \"<style>\" pages/*.html)",
      "Bash(for f:*)",
      "Bash(do echo:*)",
      "Read(//c/Users/murau/OneDrive/Stalinis kompiuteris/POC/**)",
      "Bash(done)",
      "Bash(grep -cE \"#[0-9a-fA-F]{3,8}\" css/pages/breath-analysis.css)",
      "Bash(grep -nE \"#[0-9a-fA-F]{3,8}\" css/pages/breath-analysis.css)",
      "Bash(mkdir -p \".claude/skills/selfcritique\")",
      "Bash(mkdir -p \".claude/skills/thesis\")",
      "Bash(CLAUDE_PROJECT_DIR=\"/c/Users/murau/OneDrive/Stalinis kompiuteris/POC\" pwsh -ExecutionPolicy Bypass -File \"C:/Users/murau/.claude/hooks/spiral-session-start.ps1\")",
      "Bash(powershell -Command '$PSVersionTable.PSVersion.ToString\\(\\)')",
      "Bash(pwsh -Command '$PSVersionTable.PSVersion.ToString\\(\\)')",
      "Bash(pwsh -Command 'Join-Path \"\"C:\\\\Users\\\\murau\"\" \"\".claude\"\" \"\"skills\"\" \"\"selfcritique\"\" \"\"SKILL.md\"\"')",
      "Bash(CLAUDE_PROJECT_DIR=\"C:\\\\Users\\\\murau\\\\OneDrive\\\\Stalinis kompiuteris\\\\POC\" pwsh -ExecutionPolicy Bypass -File \"C:/Users/murau/.claude/hooks/spiral-session-start.ps1\")",
      "Bash(CLAUDE_PROJECT_DIR=\"C:\\\\Users\\\\murau\\\\Desktop\" pwsh -ExecutionPolicy Bypass -File \"C:/Users/murau/.claude/hooks/spiral-session-start.ps1\")"
    ],
    "deny": [],
    "ask": [
      "Bash(git push:*)",
      "Write(**/*.html)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright",
    "desktop-commander",
    "memory"
  ],
  "disabledMcpjsonServers": [
    "puppeteer",
    "chrome-devtools",
    "firecrawl",
    "magic",
    "arxiv",
    "chart",
    "sequential-thinking",
    "github"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\session-start.ps1\"",
            "timeout": 15,
            "statusMessage": "Gathering orientation context..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\pre-compact.ps1\"",
            "timeout": 10,
            "statusMessage": "Preserving session context before compaction..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You are a stop-validation hook. Respond with ONLY a JSON object, no markdown, no explanation, no code fences.\n\nEvaluate whether the assistant's response fully addressed the user's request.\n\nRules:\n- If the response is complete and all explicit requests are addressed, respond: {\"decision\":\"approve\"}\n- Only if there is a clear, genuine omission (not minor improvements), respond: {\"decision\":\"block\",\"reason\":\"<one sentence>\"}\n- Default to approve. Most responses are complete.\n\nYour entire response must be exactly one JSON object. Nothing else.",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "commit-commands@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "hookify@claude-code-plugins": false,
    "plugin-dev@claude-code-plugins": false,
    "pr-review-toolkit@claude-code-plugins": true,
    "ralph-wiggum@claude-code-plugins": false,
    "claude-opus-4-5-migration@claude-code-plugins": true,
    "frontend-design@claude-code-plugins": true
  }
}
