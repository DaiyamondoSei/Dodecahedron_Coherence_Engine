{
  "env": {
    "PROJECT_TYPE": "web-visualization",
    "FRAMEWORK": "vanilla-js-threejs",
    "NODE_ENV": "development"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(python:*)",
      "Bash(git:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git tag:*)",
      "Bash(git -C:*)",
      "Bash(gh:*)",
      "Bash(claude:*)",
      "Bash(start:*)",
      "Bash(cmd:*)",
      "Bash(cmd /c:*)",
      "Bash(powershell:*)",
      "Bash(timeout:*)",
      "Bash(curl:*)",
      "Bash(dir:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(findstr:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(copy:*)",
      "Bash(move:*)",
      "Bash(mkdir:*)",
      "Bash(tasklist:*)",
      "Bash(taskkill:*)",
      "Bash(netstat:*)",
      "Read(**/*)",
      "Write(**/js/**/*.js)",
      "Write(**/css/**/*.css)",
      "WebSearch",
      "Skill(brainstorming)",
      "mcp__playwright__*",
      "mcp__desktop-commander__*",
      "mcp__memory__*",
      "Bash(where:*)",
      "Bash(del \"_ul\")"
    ],
    "deny": [],
    "ask": [
      "Bash(git push:*)",
      "Write(**/*.html)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright",
    "desktop-commander",
    "memory"
  ],
  "disabledMcpjsonServers": [
    "puppeteer",
    "chrome-devtools",
    "firecrawl",
    "magic",
    "arxiv",
    "chart",
    "sequential-thinking",
    "github"
  ],
  "enabledPlugins": {
    "agent-sdk-dev@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "commit-commands@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "hookify@claude-code-plugins": false,
    "plugin-dev@claude-code-plugins": false,
    "pr-review-toolkit@claude-code-plugins": true,
    "ralph-wiggum@claude-code-plugins": false,
    "claude-opus-4-5-migration@claude-code-plugins": true,
    "frontend-design@claude-code-plugins": true
  }
}
